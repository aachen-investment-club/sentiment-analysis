AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=eu-central-1


COGNITO_DOMAIN_PREFIX =...
COGNITO_CLIENT_ID =...
COGNITO_USER_POOL_ID=<region>_<poolId>
AWS_COGNI_CLIENT_SECRET =...

# Signs session cookies used for authentication. Required - the app refuses to
# start without it. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=<YOUR_RANDOM_SESSION_SECRET>

FRONTEND_ORIGIN=http://localhost:3000

# Used by docker-compose to bake the backend URL into the frontend build
# (Next.js resolves NEXT_PUBLIC_* vars at build time, not runtime).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local/dev only (docker-compose): backend talks to FinBERT directly over HTTP.
FINBERT_URL=http://localhost:7575

# Prod only: name of the invoke-finbert Lambda. When set, the backend calls
# FinBERT through this Lambda via IAM instead of FINBERT_URL directly.
# See aws/lambda/invoke_finbert.py and aws/iam/invoke-finbert-resource-policy.md
FINBERT_LAMBDA_NAME=invoke-finbert

# HuggingFace token for model downloads (required for finbert service)
HF_TOKEN=<YOUR_HF_TOKEN>
