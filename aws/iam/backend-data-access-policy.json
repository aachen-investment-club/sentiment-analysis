{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSentimentOutputsTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-central-1:058264123925:table/developer-sentiment-analysis-outputs"
    },
    {
      "Sid": "AllowDocumentTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:eu-central-1:058264123925:table/sentiment_document_data"
    },
    {
      "Sid": "AllowArticlesBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::articles-sentiment/*"
    },
    {
      "Sid": "AllowArticlesBucketListing",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::articles-sentiment"
    }
  ]
}
