{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowStartAndDescribeFinbertInstanceOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:DescribeInstances"
      ],
      "Resource": "arn:aws:ec2:eu-central-1:058264123925:instance/<YOUR_FINBERT_INSTANCE_ID>"
    }
  ]
}
